{
  "name": "tradegate-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "test": "node --test server/*.test.js src/*.test.js",
    "test:db": "node --test server/database.integration.test.js",
    "db:migrate": "node server/migrate.js",
    "ingest:once": "node server/ingest-once.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "vite": "^8.2.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
