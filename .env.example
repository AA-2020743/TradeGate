# Server port used in development and production.
HOST=127.0.0.1
PORT=8787

# Optional. Enables equities, ETFs, FX, and selected metals proxies.
TWELVE_DATA_API_KEY=
TWELVE_MIN_INTERVAL_MS=8000

# Optional. Enables official FRED liquidity and macro series.
FRED_API_KEY=

# PostgreSQL persistence and scheduled ingestion.
DATABASE_URL=
DATABASE_SSL=false
INGESTION_ENABLED=false
MARKET_REFRESH_MS=60000
MACRO_REFRESH_MS=21600000
HISTORY_REFRESH_MS=86400000

# Optional. Use when the web client is hosted separately from the API.
# API_BASE_URL=http://localhost:8787
