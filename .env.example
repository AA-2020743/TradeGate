# Server binding
HOST=127.0.0.1
PORT=8787

# Credentialed providers (all optional - the platform runs fully keyless)
TWELVE_DATA_API_KEY=
TWELVE_MINUTE_CREDIT_LIMIT=8
TWELVE_DAILY_CREDIT_LIMIT=760
TWELVE_INTERACTIVE_DAILY_LIMIT=140
TWELVE_MAX_INTERACTIVE_WAIT_MS=10000
TWELVE_QUOTE_REFRESH_MS=900000
FRED_API_KEY=

# Persistence (Postgres). When set, ingestion history and model narratives activate.
DATABASE_URL=
DATABASE_SSL=false

# Background ingestion scheduler
INGESTION_ENABLED=false
MARKET_REFRESH_MS=900000
MACRO_REFRESH_MS=21600000
HISTORY_REFRESH_MS=86400000
