[Unit]
Description=TradeGate research platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tradegate
Group=tradegate
WorkingDirectory=/home/tradegate/TradeGate
EnvironmentFile=/home/tradegate/TradeGate/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/tradegate/TradeGate

[Install]
WantedBy=multi-user.target
